# Public origin of the deployed site, without a trailing slash (for example https://manar.example).
# Used for canonical URLs, hreflang alternates, and social images. Read at build time.
# Leave empty until the production domain is decided; those tags are then omitted.
SITE_URL=

# Resend API key (server-side only). Without it, demo requests fail visibly and no email is sent.
RESEND_API_KEY=

# Sender for demo request emails, on a domain verified in Resend,
# for example: Manar <demo@mail.your-verified-domain>
DEMO_FROM_EMAIL=
