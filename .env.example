# Public origin of the deployed site. Read at build time, including in Docker/CI.
# Used for the sitemap, robots.txt, canonical URLs, hreflang, structured data, and social images.
# Defaults to the production domain below. Overrides must be HTTP(S) origins without a path.
SITE_URL=https://manar.vax.sh

# Resend API key (server-side only). Without it, demo requests fail visibly and no email is sent.
RESEND_API_KEY=

# Sender for demo request emails, on a domain verified in Resend,
# for example: Manar <demo@mail.your-verified-domain>
DEMO_FROM_EMAIL=

# PostHog EU project key (public, build time). Optional. Placeholder: phc_xxxxxxxxxxxxxxxx
# When set, the consent banner appears and PostHog (cookieless, eu.i.posthog.com) loads only after a visitor allows analytics.
# When empty, the site has no optional processing and shows no banner.
NEXT_PUBLIC_POSTHOG_KEY=

# Cloudflare Turnstile site key (public, build time). Shown on the /meet booking pages.
# Without it, bookings send a development token that only manar-site's development adapter accepts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# manar-site origin (server-side, runtime), for example http://localhost:4310.
# Published content is read from GET /public/content/:locale and /meet is proxied to /public/meet/*.
# When empty or unreachable, the site renders the bundled content and /meet offers the request form.
SITE_API_URL=
# The admin console's origin (runtime), the only page allowed to frame a preview, for example
# http://localhost:3410. Empty: previews open in their own tab and nothing may frame the site.
ADMIN_ORIGIN=

# Shared secret for POST /api/revalidate (server-side, runtime, at least 32 characters).
# manar-site sends it as "Authorization: Bearer <secret>" after publishing. Empty disables the route.
REVALIDATE_SECRET=

# Launch offer counter ("37 of 100 left"): the public API origin (runtime). Empty: no counter is shown.
MANAR_API_URL=
# Community link (Discord invite, https). Empty: no Discord link is shown.
MANAR_DISCORD_URL=
